# Copy to .env and fill in. Never commit .env.

# --- Enrichment (all free, no paid data provider) ---
# Company discovery uses the public YC OSS JSON feed, which needs no key.
# Groq is optional and only writes one personalised sentence per email.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_CALLS_PER_RUN=40

# Politeness limits for scraping company sites.
HTTP_RATE_LIMIT_PER_MIN=30
HTTP_MAX_FETCHES_PER_RUN=400
SCRAPE_USER_AGENT=Mozilla/5.0 (compatible; mailbot/0.1; +job-search-outreach)

# --- SMTP delivery ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Resend delivery (alternative to SMTP) ---
RESEND_API_KEY=

# EMAIL_BACKEND: smtp | resend
EMAIL_BACKEND=smtp

# --- Identity ---
FROM_EMAIL=
FROM_NAME=
REPLY_TO=
UNSUBSCRIBE_MAILTO=

# --- Bounce scanning (IMAP, optional but recommended) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- GitHub discovery and enrichment (free) ---
# Two jobs. Commit emails are published by the person, so they work even on
# catch-all domains where SMTP verification proves nothing, and they reveal the
# domain's address pattern, which lets us build a founder address from evidence.
# Org search by city ('gh' command) also finds companies that are not in the YC
# directory, which is where most non-San-Francisco volume comes from.
# Enrichment works with no token at 60 requests/hour, but the search endpoint
# requires one. A free classic token with NO scopes ticked raises the limit to
# 5000: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MAX_CALLS_PER_RUN=50

# --- Paths ---
DB_PATH=outreach.db
TEMPLATE_PATH=config/template.txt
# Each reply gets an answer drafted from this file and saved to your Drafts
# folder over IMAP. Drafts are never sent. No file means no drafts.
REPLY_TEMPLATE_PATH=config/reply.txt
# The filename is what the recipient sees on the attachment, so name it
# after yourself rather than leaving it as resume.pdf.
RESUME_PATH=assets/your_name_resume.pdf
# Hosted resume, shown as a "my resume" link under the signature. When set,
# the PDF above is not attached (cold mail with a PDF is more likely to be
# filtered); leave empty to attach the PDF instead. Never both.
RESUME_LINK=

# --- Targeting ---
TARGET_LOCATIONS=San Francisco,New York,Toronto
TARGET_INDUSTRIES=machine learning,artificial intelligence
# Read the whole YC directory instead of only its AI tags.
YC_ALL_TAGS=false
# Locations for YC discovery only, matched as substrings of a company's
# listed locations ("usa" takes every US company). Empty = TARGET_LOCATIONS.
YC_LOCATIONS=
MAX_COMPANY_AGE_YEARS=5
MAX_EMPLOYEES=200
TARGET_ROLES=founder,co-founder,cto,lead engineer,ml engineer
# Only approach companies flagged as hiring on their YC profile.
HIRING_ONLY=true

# --- Sending guardrails ---
DAILY_SEND_LIMIT=25

# Warmup ramp. DAILY_SEND_LIMIT above is the ceiling the ramp climbs to, not
# the volume sent on day one: a young address that opens at full volume reads
# as a blast. The cap starts at SEND_RAMP_START and gains SEND_RAMP_STEP for
# each day actually sent on, so with the defaults it runs 8, 10, 12 ... up to
# DAILY_SEND_LIMIT and then stays there. Days are counted by days sent on, so
# weekends and outages do not inflate it. If the bounce rate over the last
# 100 sends goes above SEND_RAMP_MAX_BOUNCE_PCT the cap drops back to
# SEND_RAMP_START until it recovers (0 turns that brake off). Set
# SEND_RAMP_ENABLED=false to send at DAILY_SEND_LIMIT from the start.
SEND_RAMP_ENABLED=true
SEND_RAMP_START=8
SEND_RAMP_STEP=2
SEND_RAMP_MAX_BOUNCE_PCT=5
# The cap is also never more than this multiple of the busiest recent send
# day, so coming off a hold it grows 8, 16, 25 instead of jumping 8 to 25.
# 0 turns that limit off.
SEND_RAMP_MAX_GROWTH=2

# Catch-all domains accept any address, so the SMTP check proves nothing
# there. Above this recent bounce rate, only catch-all addresses the person
# published themselves (HN post, founder's own page) are mailed; above double
# it, none are. Verified addresses are never affected. 0 turns this off.
CATCHALL_STRICT_BOUNCE_PCT=3

# One day's bounce rate, judged after the send window closes and mailed to you
# when it goes over. The ramp brake above reads the last hundred sends, which
# is the right measure for sender reputation but cannot see a single bad day.
# MIN_SENDS stops a quiet day reading as a catastrophe: one bounce out of two
# is 50% and means nothing. 0 turns the alert off.
DAILY_BOUNCE_ALERT_PCT=15
DAILY_BOUNCE_ALERT_MIN_SENDS=3
SEND_DELAY_SECONDS=20
# How often the send timer fires. Each tick sends its zone's share of the
# day's cap divided by the ticks left in that recipient's window, so the cap,
# not a fixed number per tick, decides the day.
SEND_TICK_MINUTES=15
# Share of the daily cap kept for follow-ups while any are due. Unused slots
# go back to first emails, and once no first email is left for the day,
# follow-ups may use the rest.
FOLLOWUP_SHARE_PCT=33
# Where health and bounce alerts are mailed. Empty = FROM_EMAIL. A second
# sending account sets this to the main address, since nobody reads its inbox.
ALERT_TO=

# --- Second sending account (volume lane) ---
# Optional. Put the second account's settings in .env.volume beside this file:
# FROM_EMAIL, SMTP_USER, SMTP_PASS, IMAP_USER and IMAP_PASS are required there,
# and anything else it sets (DAILY_SEND_LIMIT, the ramp, ALERT_TO) overrides
# this file for that account only. It shares this database: nobody is mailed
# by both accounts, and an opt-out or bounce in either closes them for both.
# It sends what main leaves once main has used its whole cap, plus the
# addresses only it may send (below). scripts/job.sh runs it after main.
#
# Keep first-name guesses on catch-all domains, and published site addresses
# there that name nobody, reserved for the volume lane, instead of discarding
# them. The main account never sends them.
VOLUME_GUESSES=false
# The volume lane's brake on those guesses: above this recent bounce rate on
# that account, or above it today with two or more bounced, they wait.
# 0 turns this off.
GUESS_MAX_BOUNCE_PCT=6
# When a guess hard-bounces, that convention is wrong at that company. After
# this many days the person gets one retry at the next likeliest convention,
# and colleagues still waiting on the disproved one are re-guessed before
# they bounce too. Never more than two addresses per person.
GUESS_RETRY_AFTER_DAYS=2
# Refuse to queue an address below this confidence. 70 keeps out every
# guessed address on a catch-all domain, which is where bounces come from.
MIN_CONFIDENCE=70
# How many people at one company may be written to. Colleagues never get
# mail on the same day, and once anyone there replies, opts out or hard
# bounces, nobody else at that company is contacted. 1 restores the old
# one-person-per-company rule.
MAX_CONTACTS_PER_COMPANY=3
# Send SMTP probes through a SOCKS5 relay instead of directly. Only for a
# network that blocks outbound port 25 (the server does not): set
# 127.0.0.1:1080 and run scripts\probe_relay.ps1 on a machine that is not
# blocked. Empty = direct.
SMTP_PROBE_RELAY=
# Sending is refused outside this local window and on weekends.
SEND_WINDOW_START=08:30
SEND_WINDOW_END=10:30
SEND_TIMEZONE=America/Toronto
# Leave true until you have read a few previews. Set false to actually send.
DRY_RUN=true

# --- Drafting ahead ---
# How many finished drafts to keep waiting. The drafting job runs every two
# hours and stops as soon as the queue is this deep, so it costs nothing on a
# run that finds it full. Keep it comfortably above DAILY_SEND_LIMIT: the
# point is that a day where this machine never wakes still has stock to send
# the moment it does.
QUEUE_TARGET=60
# Copy every queued draft into the Gmail Drafts folder, so a day is not lost
# when the laptop is closed: open Gmail on a phone and send by hand. The copy
# is deleted as soon as the bot sends it, and a draft you send yourself is
# noticed and taken out of the queue, so nothing goes out twice. Needs the
# same IMAP settings as bounce scanning.
MIRROR_TO_DRAFTS=true
# Companies to treat as high priority. They skip the team-size, age and
# location gates and are enriched, drafted and sent before anything else.
PRIORITY_PATH=config/priority.txt
# US and Canadian fund portfolio pages, one "fund | country | url" per line.
VC_PORTFOLIOS_PATH=config/vc_portfolios.txt
# A portfolio domain ranked inside this many sites on the Tranco list is a
# big company (Airbnb, Coinbase) and is skipped. 0 turns the filter off.
VC_MAX_SITE_RANK=20000
